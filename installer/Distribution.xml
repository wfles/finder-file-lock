<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Finder File Lock</title>
  <options customize="never" hostArchitectures="arm64,x86_64" require-scripts="false"/>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <allowed-os-versions><os-version min="15.0"/></allowed-os-versions>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <choices-outline><line choice="default"/></choices-outline>
  <choice id="default" visible="false"><pkg-ref id="io.github.wfles.finder-file-lock"/></choice>
  <pkg-ref id="io.github.wfles.finder-file-lock">file-actions-component.pkg</pkg-ref>
</installer-gui-script>
